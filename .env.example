# Copia este archivo a .env y completa los valores. NO subas .env al repositorio.

# --- Base de datos de la aplicación (FastAPI) ---
APP_DB_NAME=app_db
APP_DB_USER=app_user
APP_DB_PASSWORD=cambiar_esta_contraseña

# --- Base de datos de MLflow ---
MLFLOW_DB_NAME=mlflow_db
MLFLOW_DB_USER=mlflow_user
MLFLOW_DB_PASSWORD=cambiar_esta_contraseña

# --- Base de datos de Airflow ---
AIRFLOW_DB_NAME=airflow_db
AIRFLOW_DB_USER=airflow_user
AIRFLOW_DB_PASSWORD=cambiar_esta_contraseña

# --- Airflow ---
# En Linux usa tu UID (comando: id -u) para que los archivos montados no queden como root.
AIRFLOW_UID=1000
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Generar: openssl rand -hex 32
AIRFLOW_JWT_SECRET=cambiar_este_secreto
# Usuario administrador (UI y API REST)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambiar_esta_contraseña
